<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <artifactId>getmailconfig</artifactId>
  <version>${revision}</version>
  <name>getmailconfig</name>
  <description>Getmail configuration tool</description>
  <packaging>jar</packaging>
  <groupId>kwee</groupId>

  <properties>
    <revision>1.2.0.1</revision>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.url>tools</project.url>
    <project.version>${revision}</project.version>
    <project.copyright.text>Copyright © 2026 RSH Kwee. Alle rechten voorbehouden.</project.copyright.text>

    <downloadUrl.jre>https://cdn.azul.com/zulu/bin/zulu25.36.205-ca-jre25.0.4.1-win_x64.zip</downloadUrl.jre>
    <companyName>Prive RK</companyName>

    <maven.min.version>3.6.3</maven.min.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven.compiler.release>25</maven.compiler.release>

    <maven.test.failure.ignore>true</maven.test.failure.ignore>

    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-surefirereport-plugin.version>3.6.0</maven-surefirereport-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-assembly-plugin.version>3.8.0</maven-assembly-plugin.version>
    <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
    <maven-antrun-pluginversion>3.2.0</maven-antrun-pluginversion>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-versions-maven-plugin.version>2.22.0</maven-versions-maven-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
    <maven-jarsigner-plugin.version>3.1.0</maven-jarsigner-plugin.version>

    <launch4j-maven-plugin.version>2.7.0</launch4j-maven-plugin.version>
    <jsign-maven-plugin.version>7.6</jsign-maven-plugin.version>

    <versions-maven-plugin.version>2.22.0</versions-maven-plugin.version>
    <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
    <codehaus-mojo.maven-plugin.version>1.8.0</codehaus-mojo.maven-plugin.version>

    <org.codehaus.mojo.build-helper-maven-plugin.version>3.0.0</org.codehaus.mojo.build-helper-maven-plugin.version>

    <org-apache-poi-poi.version>5.5.1</org-apache-poi-poi.version>
    <org-apache-poi-ooxml.version>5.5.1</org-apache-poi-ooxml.version>
    <jakarta-mail.version>2.0.2</jakarta-mail.version>
    <org.apache.velocity.velocity-engine-core>2.3</org.apache.velocity.velocity-engine-core>
	
    <org.apache.logging.log4j.log4j-to-jul>2.25.2</org.apache.logging.log4j.log4j-to-jul>
	<org.slf4j.slf4j-jdk14>2.0.17</org.slf4j.slf4j-jdk14>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${org.slf4j.slf4j-jdk14}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>kwee</groupId>
      <artifactId>library</artifactId>
      <version>1.2.0.1</version>
    </dependency>
    <dependency>          <!-- Apache POI voor Excel -->
      <groupId>org.apache.poi</groupId>
      <artifactId>poi</artifactId>
      <version>${org-apache-poi-poi.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${org-apache-poi-ooxml.version}</version>
    </dependency>

    <!-- JavaMail (IMAP) -->
    <dependency>
      <groupId>com.sun.mail</groupId>
      <artifactId>jakarta.mail</artifactId>
      <version>${jakarta-mail.version}</version>
    </dependency>

    <!-- Apache Velocity voor templating -->
    <dependency>
      <groupId>org.apache.velocity</groupId>
      <artifactId>velocity-engine-core</artifactId>
      <version>${org.apache.velocity.velocity-engine-core}</version>
    </dependency>

    <!-- Logging -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-to-jul</artifactId>
      <version>${org.apache.logging.log4j.log4j-to-jul}</version>
      <scope>runtime</scope>
    </dependency>
	<dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <version>${org.slf4j.slf4j-jdk14}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>versions-maven-plugin</artifactId>
        <version>${maven-versions-maven-plugin.version}</version>
        <configuration>
          <ruleSet>
            <ignoreVersions>
              <!-- Negeer alle SNAPSHOT-versies -->
              <ignoreVersion>
                <type>regex</type>
                <version>(.+-SNAPSHOT|.+-M\d)</version>
              </ignoreVersion>
              <ignoreVersion>
                <type>regex</type>
                <version>.*-M\d*</version>
              </ignoreVersion>
              <!-- Negeer alpha- en beta-versies -->
              <ignoreVersion>
                <type>regex</type>
                <version>.*[-_\.](alpha|beta|rc|m)[-_\.]?\d*</version>
              </ignoreVersion>
            </ignoreVersions>
          </ruleSet>
        </configuration>
      </plugin>

      <!-- VERVANGEN: maven-assembly-plugin -> maven-shade-plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven-shade-plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>getmailcnf</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>kwee.getmailconfig.main.Main</mainClass>
                </transformer>
                <!-- CRUCIAAL voor Apache POI: voegt META-INF/services samen -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>${maven-clean-plugin.version}</version>
        <configuration>
            <force>true</force>
        </configuration>
      </plugin>

      <!-- Library -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-maven-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>${maven.min.version}</version> <!-- Minimale Maven-versie vereist -->
                </requireMavenVersion>
              </rules>
              <fail>false</fail> <!-- Niet Stoppen de build bij niet-naleving -->
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-site-plugin</artifactId>
        <version>${maven-site-plugin.version}</version>
        <configuration></configuration>
        <executions>
          <execution>
            <id>attach-site</id>
            <goals>
              <goal>site</goal>
            </goals>
            <phase>post-integration-test</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <argLine>-Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
          <testFailureIgnore>true</testFailureIgnore>
          <reportsDirectory>${project.build.directory}/surefire-reports</reportsDirectory>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${codehaus-mojo.maven-plugin.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten.clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- LAUNCH4J create executable v -->
      <plugin>
         <groupId>com.akathist.maven.plugins.launch4j</groupId>
         <artifactId>launch4j-maven-plugin</artifactId>
         <version>${launch4j-maven-plugin.version}</version>
         <executions>
           <execution>
             <id>l4j-clui</id>
             <phase>package</phase>
             <goals>
               <goal>launch4j</goal>
             </goals>
             <configuration>
               <headerType>console</headerType>
               <!-- AANGEPAST: shade produceert getmailcnf.jar -->
               <jar>${project.build.directory}/getmailcnf.jar</jar>
               <outfile>${project.build.directory}/getmailcnf.exe</outfile>
               <downloadUrl>${downloadUrl.jre}</downloadUrl>
               <classPath>
                 <mainClass>kwee.getmailconfig.main.Main</mainClass>
              </classPath>
              <jre>
                <path>%java_home%</path>
              </jre>
              <!-- <icon>src/main/resources/ingSNSLogo.ico</icon> -->
              <versionInfo>
                <fileVersion>${project.version}</fileVersion>
                <txtFileVersion>${project.version}</txtFileVersion>
                <fileDescription>${project.name}</fileDescription>
                <copyright>C</copyright>
                <productVersion>${project.version}</productVersion>
                <txtProductVersion>${project.version}</txtProductVersion>
                <productName>${project.name}</productName>
                <internalName>getmailconfig</internalName>
                <originalFilename>getmailconfig.exe</originalFilename>
                <companyName>${companyName}</companyName>
              </versionInfo>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- LAUNCH4J ^ -->

      <!-- Sign executable v -->
      <plugin>
        <groupId>net.jsign</groupId>
        <artifactId>jsign-maven-plugin</artifactId>
        <version>${jsign-maven-plugin.version}</version>
        <executions>
          <execution>
           <id>sign_exe</id>
           <phase>package</phase>
            <goals>
              <goal>sign</goal>
            </goals>
            <configuration>
              <file>${project.build.directory}/getmailcnf.exe</file>
              <name>ING OFX Converter</name>
              <url>https://github.com/RSHKwee/ing2ofx</url>
              <keystore>keystore.jks</keystore>
              <alias>RSHK</alias>
              <storepass>${keystore.password}</storepass>
            </configuration>
          </execution>
          <!--
          <execution>
            <id>sign_inst</id>
            <phase>install</phase>
            <goals>
              <goal>sign</goal>
            </goals>
            <configuration>
              <file>${project.build.directory}/ing2ofx_v${project.version}_setup.exe</file>
              <name>ING OFX Converter</name>
              <url>https://github.com/RSHKwee/ing2ofx</url>
              <keystore>keystore.jks</keystore>
              <alias>RSHK</alias>
              <storepass>${keystore.password}</storepass>
            </configuration>
          </execution>
          -->
        </executions>
      </plugin>

    </plugins>
    <!--   <directory>f:/temp/local_target/${project.artifactId}</directory>   -->
  </build>

  <distributionManagement>
    <!-- Upload to Github v-->
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/RSHKwee/getmailconfig</url>
    </repository>
    <!-- Upload to Github ^-->
  </distributionManagement>
</project>